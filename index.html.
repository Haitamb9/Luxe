<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LUXE Department Store</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#ffffff;
    color:#222;
}

header{
    background:#fff;
    border-bottom:1px solid #ddd;
    position:sticky;
    top:0;
}

.top-bar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:15px 5%;
    flex-wrap:wrap;
}

.logo{
    font-size:32px;
    font-weight:bold;
}

.search-box{
    width:350px;
    max-width:100%;
    padding:12px;
    border:1px solid #ccc;
    border-radius:5px;
}

.cart{
    font-size:26px;
}

nav{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:25px;
    padding:15px;
}

nav a{
    text-decoration:none;
    color:#222;
    font-weight:bold;
}

.sale-banner{
    background:black;
    color:white;
    text-align:center;
    padding:12px;
}

.hero{
    background:#f5f5f5;
    height:450px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
}

.hero-content h1{
    font-size:48px;
    margin-bottom:15px;
}

.hero-content p{
    margin-bottom:20px;
    font-size:20px;
}

.hero-btn{
    background:black;
    color:white;
    text-decoration:none;
    padding:14px 28px;
    border-radius:5px;
}

.container{
    width:90%;
    max-width:1200px;
    margin:auto;
}

.section-title{
    text-align:center;
    margin:50px 0 30px;
    font-size:36px;
}

.categories{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    margin-bottom:50px;
}

.category{
    background:#f2f2f2;
    padding:40px;
    text-align:center;
    font-weight:bold;
    font-size:20px;
}

.products{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:25px;
}

.product{
    border:1px solid #ddd;
    border-radius:8px;
    overflow:hidden;
    background:white;
}

.product img{
    width:100%;
    height:250px;
    object-fit:cover;
}

.product-info{
    padding:15px;
}

.brand{
    color:gray;
    font-size:14px;
}

.product-name{
    font-size:18px;
    font-weight:bold;
    margin:10px 0;
}

.price{
    font-size:22px;
    font-weight:bold;
}

.button{
    margin-top:15px;
    display:block;
    text-align:center;
    background:black;
    color:white;
    text-decoration:none;
    padding:10px;
    border-radius:4px;
}

footer{
    margin-top:60px;
    background:#111;
    color:white;
    text-align:center;
    padding:40px;
}

@media(max-width:768px){

.hero{
    height:350px;
}

.hero-content h1{
    font-size:32px;
}

.search-box{
    width:100%;
    margin-top:10px;
}

}
</style>
</head>

<body>

<header>

<div class="top-bar">
<div class="logo">LUXE</div>

<input class="search-box" type="text" placeholder="Search fragrances, shoes, fashion...">

<div class="cart">🛒</div>
</div>

<nav>
<a href="#">Perfume</a>
<a href="#">Men</a>
<a href="#">Women</a>
<a href="#">Shoes</a>
<a href="#">Brands</a>
<a href="#">Sale</a>
</nav>

</header>

<div class="sale-banner">
🔥 Up To 40% Off Selected Collections 🔥
</div>

<section class="hero">
<div class="hero-content">
<h1>Luxury Fashion & Fragrance</h1>
<p>Shop style, scent and footwear in one place.</p>
<a href="#" class="hero-btn">Shop Now</a>
</div>
</section>

<div class="container">

<h2 class="section-title">Shop Categories</h2>

<div class="categories">
<div class="category">Perfumes</div>
<div class="category">Men's Fashion</div>
<div class="category">Women's Fashion</div>
<div class="category">Shoes</div>
</div>

<h2 class="section-title">Featured Products</h2>

